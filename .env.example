# ==============================================================================
# CVCraft Production Environment Configuration (.env.example)
# Copy this file to .env or configure these variables in the Render Dashboard.
# NEVER commit production secrets or credentials to public source control.
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=10000

# MongoDB Atlas Database Connection (Required for persistent production storage)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://cvcraft_user:your_secure_password@cluster0.xxxxx.mongodb.net/cvcraft?retryWrites=true&w=majority

# JWT Authentication Secret (Required for user authentication & secure sessions)
# Generate a random 64-char string: `openssl rand -base64 48`
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_characters

# Super Admin Control Center Security
# Used for direct API administration and seed data management
ADMIN_KEY=replace_with_a_strong_admin_secret_key_2026
ADMIN_EMAILS=nirbodh3@gmail.com,admin@cvcraft.com

# Cloudinary Integration (Profile photos & template image asset hosting)
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively provide full URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google Gemini API Key (For AI summary generation and translation)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL & CORS (Optional)
# If frontend is served from the same Express instance on Render, leave unset or set to your Render URL:
CLIENT_URL=https://cvcraft.onrender.com

# Frontend API URL (Optional, for decoupled frontend hosting on Vercel/Netlify)
# Leave blank when deploying as a single unified Render Web Service:
# VITE_API_URL=https://cvcraft.onrender.com
